# ─────────────────────────────────────────────────────────
# FutureCV — Backend AI Service  (.env)
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────
APP_NAME=FutureCV Backend AI
ENV=development

# ── Server ──────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── LLM Provider ────────────────────────────────────────
# Supported: "openai" | "gemini" | "anthropic"
# Provider and model will be selected after benchmark evaluation.
LLM_PROVIDER=
LLM_MODEL=

# Provider API keys — only the selected provider's key is required.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Internal Service Authentication ─────────────────────
# Used for .NET Backend → AI Service communication.
# See: app/core/security/auth.py
INTERNAL_API_KEY=

# ── LLM Resilience ─────────────────────────────────────
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=INFO
