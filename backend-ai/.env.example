# ─────────────────────────────────────────────────────────
# FutureCV — Backend AI Service (.env)
# Copy this file to .env and configure your environment.
# ─────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────
APP_NAME=FutureCV Backend AI
ENV=development

# ── Server ──────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── LLM Provider ────────────────────────────────────────
# Supported: "mock" | "openai" | "gemini" | "anthropic"
# Default is "mock" for local development without API keys.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini

# Provider API keys — only the selected provider's key is required.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Internal Service Authentication ─────────────────────
# Pre-shared secret for ASP.NET Core -> FastAPI communication.
# Sent in header: X-Internal-API-Key
# (Optional in development; required in production).
INTERNAL_API_KEY=

# ── LLM Resilience ─────────────────────────────────────
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ── Logging ─────────────────────────────────────────────
# Levels: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Security & Document Constraints ─────────────────────
# Maximum file upload size in bytes (Default: 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760
# Maximum PDF pages allowed for parsing (Default: 20 pages)
MAX_PDF_PAGES=20
# Maximum text characters extracted from CV document
MAX_EXTRACTED_TEXT_CHARS=50000
